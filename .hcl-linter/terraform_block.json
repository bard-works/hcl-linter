{
  "rules": {
    "block_order": {
      "enabled": true,
      "order": ["locals"]
    },
    "array_format": {
      "enabled": true,
      "multiline_threshold": 2
    },
    "terraform_block": {
      "enabled": true,
      "source_required": true,
      "version_format": true,
      "extra_arguments_valid": true,
      "no_deprecated_fields": true
    }
  }
}